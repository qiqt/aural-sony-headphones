file(MAKE_DIRECTORY "${TEST_DIR}/Aural")
file(GLOB qml_files "${SOURCE_DIR}/../qml/*.qml")
file(WRITE "${TEST_DIR}/Aural/qmldir" "module Aural\nsingleton Hp 1.0 Hp.qml\n")
foreach(qml IN LISTS qml_files)
    get_filename_component(name "${qml}" NAME_WE)
    configure_file("${qml}" "${TEST_DIR}/Aural/${name}.qml" COPYONLY)
    if(name STREQUAL "Theme")
        file(APPEND "${TEST_DIR}/Aural/qmldir" "singleton Theme 1.0 Theme.qml\n")
    else()
        file(APPEND "${TEST_DIR}/Aural/qmldir" "${name} 1.0 ${name}.qml\n")
    endif()
endforeach()
configure_file("${SOURCE_DIR}/qml/Hp.qml" "${TEST_DIR}/Aural/Hp.qml" COPYONLY)
if(WIN32)
    set(ENV{QT_QPA_FONTDIR} "$ENV{WINDIR}/Fonts")
endif()
execute_process(COMMAND "${RUNNER}" -platform offscreen -input "${SOURCE_DIR}/qml/tst_controls.qml" -import "${TEST_DIR}" -o results.txt,txt
    WORKING_DIRECTORY "${TEST_DIR}" RESULT_VARIABLE result TIMEOUT 60)
if(EXISTS "${TEST_DIR}/results.txt")
    file(READ "${TEST_DIR}/results.txt" output)
    message("${output}")
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "QML interaction tests failed: ${result}")
endif()
